{
    "name": "gt264/login-fiesta",
    "description": "A Laravel package providing authentication and login flows.",
    "keywords": [
        "laravel",
        "authentication",
        "login",
        "login-fiesta"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Michele Ferretti",
            "email": "ferretti.m91@gmail.com"
        }
    ],
    "require": {
        "php": ">=8.3",
        "illuminate/contracts": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "laravel/fortify": "^1.38"
    },
    "require-dev": {
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "pestphp/pest": "^2.0|^3.0"
    },
    "autoload": {
        "psr-4": {
            "GT264\\LoginFiesta\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "GT264\\LoginFiesta\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "GT264\\LoginFiesta\\LoginFiestaServiceProvider"
            ],
            "aliases": {
                "LoginFiesta": "GT264\\LoginFiesta\\Facades\\LoginFiesta"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:coverage": "pest --coverage",
        "format": "pint"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
